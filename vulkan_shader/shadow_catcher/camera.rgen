#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_ARB_shader_clock : enable
#extension GL_GOOGLE_include_directive : enable


#include "random.glsl"
#include "ray.glsl"

layout(location = 0) rayPayloadEXT Ray ray;

layout(set = 0, binding = 0, rgba32f) uniform image2D outHdrColor;
layout(set = 0, binding = 1, rgba32f) uniform image2D outAlbedo;
layout(set = 0, binding = 2, rgba32f) uniform image2D outNormal;
layout(set = 0, binding = 3, rgba32ui) uniform uimage2D outSegmentation;
layout(set = 0, binding = 4, rgba32f) uniform image2D outRadiance;
layout(set = 0, binding = 5, rgba32f) uniform image2D outPosition;

layout(set = 1, binding = 0) uniform accelerationStructureEXT tlas;

layout(set = 2, binding = 0) uniform CameraBuffer {
  mat4 viewMatrix;
  mat4 projectionMatrix;
  mat4 viewMatrixInverse;
  mat4 projectionMatrixInverse;
  mat4 prevViewMatrix;
  mat4 prevViewMatrixInverse;
  float width;
  float height;
} cameraBuffer;

#include "push_constant.glsl"



// Writes this sample's geometric AOVs of the first visible surface (normal, albedo,
// segmentation, position), or the sky when the path ended before reaching one.
void recordGeometricAovs(int sampleIndex, bool finalHit) {
  if (sampleIndex != 0) {
    return;
  }
  imageStore(outNormal, ivec2(gl_LaunchIDEXT.xy),
             vec4(finalHit ? mat3(cameraBuffer.viewMatrix) * ray.normal : vec3(0.0), 1.0));
  imageStore(outAlbedo, ivec2(gl_LaunchIDEXT.xy),
             vec4(finalHit ? ray.albedo : vec3(0.0), 1.0));
  imageStore(outSegmentation, ivec2(gl_LaunchIDEXT.xy),
             finalHit ? ray.segmentation : uvec4(0));

  vec4 position = vec4(0.0, 0.0, 0.0, 1.0);
  if (finalHit) {
    vec4 camPos = cameraBuffer.viewMatrix * vec4(ray.origin, 1.0);
    vec4 ndc = cameraBuffer.projectionMatrix * camPos;
    position = vec4(camPos.xyz, abs(ndc.w) > 1e-6 ? ndc.z / ndc.w : 1.0);
  }
  imageStore(outPosition, ivec2(gl_LaunchIDEXT.xy), position);
}

void main() {
  vec2 invScreen = vec2(2.0) / gl_LaunchSizeEXT.xy;
  vec2 pixel = gl_LaunchIDEXT.xy * invScreen - 1.0;
  // Deterministic per pixel and per render: frameSeed counts this camera's renders, so the
  // noise pattern changes every frame even when accumulation restarts (frameCount == 0).
  uint seed = tea(gl_LaunchIDEXT.y * gl_LaunchSizeEXT.x + gl_LaunchIDEXT.x,
                  0x9e3779b9u + uint(frameSeed));

  vec3 radiance = vec3(0.0);
  float alpha = 0.0;

  uint rayFlags = gl_RayFlagsNoneEXT;
  float tMin = 0.001f;
  float tMax = 10000.0f;

  ray.seed = seed;

  float effectiveSpp = 0.0;
  for (int i = 0; i < spp; ++i) {
    // sample point on aperture
    float at = rnd(ray.seed) * 2.0 * M_PI;
    float ar = sqrt(rnd(ray.seed)) * aperture;
    float ax = ar * cos(at);
    float ay = ar * sin(at);

    // vec2 r = vec2(rnd(ray.seed), rnd(ray.seed));
    vec2 r = halton2d(frameCount * spp + i + 1, 2, 3);

    vec2 d = pixel + r * invScreen;  // jittered pixel position
    vec4 csFar = cameraBuffer.projectionMatrixInverse * vec4(d, 1.0, 1.0);
    csFar.xyz /= csFar.w;
    vec4 csNear = cameraBuffer.projectionMatrixInverse * vec4(d, 0.0, 1.0);
    csNear.xyz /= csNear.w;
    vec3 csDir = csFar.xyz - csNear.xyz;
    vec3 csFocusOrigin = csNear.xyz;
    vec3 csFocusDir = csDir;
    if (aperture > 0.0) {
      float focusT = (focusPlane + csNear.z) / max(-csDir.z, 1e-6);
      if (abs(focusT) > 1e-6) {
        vec3 csFocusPoint = csNear.xyz + focusT * csDir;
        csFocusOrigin = csNear.xyz + vec3(ax, ay, 0.0);
        csFocusDir = csFocusPoint - csFocusOrigin;
        if (csFocusDir.z != 0.0) csFocusDir /= -csFocusDir.z;
      }
    }
    vec4 origin = cameraBuffer.viewMatrixInverse * vec4(csFocusOrigin, 1.0);
    vec4 direction = cameraBuffer.viewMatrixInverse * vec4(csFocusDir, 0.0);

    ray.origin = origin.xyz;
    ray.direction = normalize(direction.xyz);
    ray.albedo = vec3(0.0);
    ray.normal = vec3(0.0);
    ray.radiance = vec3(0.0);
    ray.alpha = 1.0;
    ray.attenuation = vec3(1.0);
    ray.depth = 0;
    ray.transmittance = vec3(1.0);
    ray.isShadow = 0;
    ray.scattered = 0;
    ray.hit = 0;

    vec3 attenuation = vec3(1.0);
    bool geomRecorded = false;
    for (ray.depth = 0; ray.depth <= maxDepth; ++ray.depth) {
      int prevScattered = ray.scattered;
      traceRayEXT(tlas,
                  rayFlags,
                  0x01,
                  0,
                  0,
                  0,
                  ray.origin,
                  tMin,
                  ray.direction,
                  tMax,
                  0);

      bool hit = ray.hit != 0;
      bool passThrough = hit && (ray.scattered == prevScattered);

      radiance += ray.radiance * attenuation;
      attenuation *= ray.attenuation;

      if (!geomRecorded && (!passThrough || ray.depth >= maxDepth)) {
        bool finalHit = hit && !passThrough;
        float a = finalHit ? ray.alpha : 0.0;
        effectiveSpp += a;
        alpha += a;
        geomRecorded = true;
        recordGeometricAovs(i, finalHit);
      }

      if (any(isnan(attenuation)) || any(isinf(attenuation)) ||
          max(max(attenuation.x, attenuation.y), attenuation.z) <= 1e-6) {
        attenuation = vec3(0.0);
        // a path that ends before it reached a visible surface still reports the sky behind the
        // last pass-through, so the geometric AOVs are never left from an older frame
        if (!geomRecorded) {
          recordGeometricAovs(i, false);
          geomRecorded = true;
        }
        break;
      }

      // Russian roulette never terminates a pass-through bounce: the ray has not reached a
      // visible surface yet, so the geometric AOVs and alpha would lose this sample
      if (russianRoulette != 0 && ray.depth >= russianRouletteMinBounces && !passThrough) {
        float continuationProbability =
            clamp(max(max(attenuation.x, attenuation.y), attenuation.z), 0.05, 0.95);
        if (rnd(ray.seed) > continuationProbability) {
          if (!geomRecorded) {
            recordGeometricAovs(i, false);
            geomRecorded = true;
          }
          break;
        }
        attenuation /= continuationProbability;
      }
    }
  }
  radiance /= effectiveSpp + 1e-6;
  alpha /= spp;

  // normal background
  if (frameCount > 0) {
    vec4 oldColor = imageLoad(outRadiance, ivec2(gl_LaunchIDEXT.xy));
    vec4 newColor = vec4(mix(oldColor, vec4(radiance, alpha), 1.0 / float(frameCount + 1)));
    imageStore(outRadiance, ivec2(gl_LaunchIDEXT.xy), newColor);
    imageStore(outHdrColor, ivec2(gl_LaunchIDEXT.xy), newColor);
  } else {
    imageStore(outRadiance, ivec2(gl_LaunchIDEXT.xy), vec4(radiance, alpha));
    imageStore(outHdrColor, ivec2(gl_LaunchIDEXT.xy), vec4(radiance, alpha));
  }

}
