#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "random.glsl"
#include "ray.glsl"
#include "geometry.glsl"
#include "push_constant.glsl"

layout(location = 0) rayPayloadInEXT Ray ray;

layout(set = 1, binding = 1) readonly buffer GeometryInstances {
  GeometryInstance i[];
} geometryInstances;

layout(set = 1, binding = 2) readonly buffer Materials {
  Material m[];
} materials;

struct Object {
  uvec4 segmentation;
  float transparency;
  int shadeFlat;
  int padding0;
  int padding1;
};

layout(set = 1, binding = 11) readonly buffer Objects {
  Object o[];
} objects;

void main() {
  Object obj = objects.o[gl_InstanceID];
  int instanceId = gl_InstanceCustomIndexEXT + gl_GeometryIndexEXT;
  Material mat = materials.m[geometryInstances.i[instanceId].materialIndex];

  bool isInside = gl_HitKindEXT == gl_HitKindBackFacingTriangleEXT;
  if (ray.isShadow != 0) {
    // A shadow ray passes the uncovered part of the surface (geometry_opacity, object
    // transparency) and the covered part's transmission. Light entering a body takes the
    // transmission tint (with transmission_depth, the colour reached at that depth). Triangles
    // run any-hit once per primitive (no duplicate invocations), so the product is exact.
    float coverage = clamp(mat.baseColor.a, 0.0, 1.0) * (1.0 - clamp(obj.transparency, 0.0, 1.0));
    float transmission = clamp(mat.transmissionWeight, 0.0, 1.0) * (1.0 - clamp(mat.metallic, 0.0, 1.0));
    vec3 tint = isInside && mat.thinWalled == 0 ? vec3(1.0) : clamp(mat.transmissionColor, 0.0, 1.0);
    ray.transmittance *= mix(vec3(1.0), transmission * tint, coverage);
    if (max(ray.transmittance.x, max(ray.transmittance.y, ray.transmittance.z)) > 0.0) {
      ignoreIntersectionEXT;
    }
    return; // fully blocked: accept the hit, which ends the ray
  }

  // path rays: fully transparent objects and back faces of opaque single-sided surfaces are
  // invisible
  if (obj.transparency > 0.99) {
    ignoreIntersectionEXT;
  }
  if (isInside && mat.transmissionWeight < 1e-4 && mat.thinWalled == 0) {
    ignoreIntersectionEXT;
  }
}
