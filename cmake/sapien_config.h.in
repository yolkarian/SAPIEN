#pragma once
/* Build options of this SAPIEN library that change public class layouts, generated by CMake from
 * cmake/sapien_config.h.in and installed as sapien/config.h. Every public header that depends on
 * them includes this file, so a program compiled against the installed headers sees the class
 * layouts of libsapien without passing -D flags. The values equal the PUBLIC compile definitions
 * of the sapien target, so in-tree builds see identical redefinitions. */

#cmakedefine SAPIEN_CUDA 1
