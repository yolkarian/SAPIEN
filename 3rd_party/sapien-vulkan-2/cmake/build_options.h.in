#pragma once
/* Compile definitions the public svulkan2 headers depend on, generated by CMake from
 * cmake/build_options.h.in and installed as svulkan2/build_options.h. Every public header that
 * includes Vulkan includes this file first, so a program compiled against the installed headers
 * matches libsvulkan2 without passing -D flags. The values equal svulkan2's PUBLIC compile
 * definitions, so in-tree builds see identical redefinitions. */

/* Vulkan entry points come from vulkan.hpp's dynamic dispatcher, whose storage libsvulkan2
 * exports. */
#ifndef VK_NO_PROTOTYPES
#define VK_NO_PROTOTYPES 1
#endif
#ifndef VULKAN_HPP_STORAGE_SHARED
#define VULKAN_HPP_STORAGE_SHARED 1
#endif

/* Members of core::Buffer, core::Image, core::Instance and the renderers. */
#cmakedefine SVULKAN2_CUDA_INTEROP 1
#cmakedefine VK_VALIDATION 1

#cmakedefine SAPIEN_MACOS 1
#ifdef SAPIEN_MACOS
#ifndef VK_USE_PLATFORM_MACOS_MVK
#define VK_USE_PLATFORM_MACOS_MVK 1
#endif
#ifndef VK_ENABLE_BETA_EXTENSIONS
#define VK_ENABLE_BETA_EXTENSIONS 1
#endif
#endif
